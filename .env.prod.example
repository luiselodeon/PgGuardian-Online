# Plantilla de variables para despliegue en producción / AWS EC2 (RF-03.5, T-17)
# En la Instancia, el .env se genera con scripts/aws/make_env.sh <AppDomain>,
# que crea secretos aleatorios, fija SANDBOX_DATA_DIR y aplica chmod 600.
# Si se crea a mano: copiar este archivo a .env, reemplazar todos los valores
# de ejemplo y protegerlo con: chmod 600 .env
#
# Este archivo NO lleva claves de AWS (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY):
# la Instancia obtiene credenciales temporales del rol PgGuardian-EC2-Role (R10.2).

# Dominio público para Caddy: output AppDomain del stack pgguardian, es decir,
# la Elastic IP con guiones + .sslip.io (3.14.15.92 -> 3-14-15-92.sslip.io).
# Respaldo (R19.4): subdominio DuckDNS. En local, ":80" para HTTP sin TLS.
APP_DOMAIN=3-14-15-92.sslip.io
VITE_API_URL=https://3-14-15-92.sslip.io/api
# Origen permitido por CORS: https://<APP_DOMAIN> (varios, separados por comas).
CORS_ORIGINS=https://3-14-15-92.sslip.io

# Seguridad detrás de Caddy HTTPS: cookie solo por HTTPS y X-Forwarded-For de Caddy.
COOKIE_SECURE=true
TRUST_PROXY_HEADERS=true

# OBLIGATORIO (RF-04.1 / R1): sin JWT_SECRET, o vacío, docker compose config/up
# fallan con "falta JWT_SECRET" y no crean contenedores. Generar con:
#   openssl rand -hex 32     (32 bytes = 64 caracteres hexadecimales, R1.4)
JWT_SECRET=reemplazar_con_openssl_rand_hex_32

# Base de datos de aplicación (app_db)
APP_DB_NAME=pgguardian_app
APP_DB_USER=pgguardian_app_user
APP_DB_PASSWORD=reemplazar_password_fuerte_appdb

# Servidor aislado de sandboxes (sandbox_db)
SANDBOX_DB_NAME=postgres
SANDBOX_DB_ADMIN_USER=sandbox_admin
SANDBOX_DB_ADMIN_PASSWORD=reemplazar_password_fuerte_sandbox_admin
SANDBOX_DB_EXEC_USER=sandbox_runner
SANDBOX_DB_EXEC_PASSWORD=reemplazar_password_fuerte_sandbox_runner

# Directorio de datos de sandbox_db en el disco EBS propio (RF-04.4).
# OBLIGATORIA en producción: sin ella los datos quedan en el disco raíz.
# En local se omite (por defecto ./.data/sandbox).
SANDBOX_DATA_DIR=/srv/sandbox/pgdata
